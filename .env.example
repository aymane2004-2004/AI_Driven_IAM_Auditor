# --- Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DORMANT_DAYS=90
CLIENT_NAME=Contoso SA (fictive)

# --- REAL DATA: app registration (needed for automation; skip if you use `az login`) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# departments allowed to hold privileged roles (comma separated)
PRIV_DEPTS=IT,Sécurité,Security,Information Technology

# --- Optional: GitHub repo metadata for screenshots and portfolio documentation ---
GITHUB_REPO=
